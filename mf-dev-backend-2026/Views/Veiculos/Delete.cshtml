@model mf_dev_backend_2026.Models.Veiculo

@{
    ViewData["Title"] = "Excluir Veículo";
}

<h1>Excluir Veículo</h1>

<div class="alert alert-danger">
    <strong>Atenção!</strong> Tem certeza que deseja excluir este veículo?
</div>

<div class="card p-4 shadow-sm">

    <table class="table table-bordered">
        <tr>
            <th>Nome</th>
            <td>@Model.nome</td>
        </tr>

        <tr>
            <th>Placa</th>
            <td>@Model.placa</td>
        </tr>

        <tr>
            <th>Ano Fabricação</th>
            <td>@Model.AnoFabricacao</td>
        </tr>

        <tr>
            <th>Ano Modelo</th>
            <td>@Model.AnoModelo</td>
        </tr>
    </table>

    <form asp-action="Delete">
        <input type="hidden" asp-for="id" />

        <button type="submit" class="btn btn-danger">
            Excluir
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>

</div>